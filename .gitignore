:root {
  --bg: #070b14;
  --bg-alt: #0d1322;
  --panel: rgba(15, 20, 31, 0.72);
  --panel-strong: rgba(18, 24, 39, 0.92);
  --line: rgba(188, 214, 255, 0.18);
  --text: #ecf3ff;
  --muted: #a9bbd5;
  --soft: #6a7ea8;
  --cyan: #55e3ff;
  --violet: #9f7cff;
  --gold: #ffd07a;
  --pink: #ff5dcf;
  --shadow: rgba(46, 139, 255, 0.4);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top, rgba(97, 75, 255, 0.28), transparent 33%),
    radial-gradient(circle at 80% 15%, rgba(23, 204, 255, 0.16), transparent 22%),
    linear-gradient(135deg, #04070d 0%, #090d18 40%, #060810 100%);
  color: var(--text);
}

body::before {
  content: '';
  position: fixed;
  inset: 0;
  background: linear-gradient(transparent, rgba(4, 8, 18, 0.2));
  pointer-events: none;
}

img {
  max-width: 100%;
  display: block;
}

button,
a {
  font: inherit;
}

#root {
  min-height: 100vh;
}

.app-shell {
  position: relative;
  overflow: hidden;
  min-height: 100vh;
  isolation: isolate;
}

.wrap {
  width: min(1200px, calc(100% - 32px));
  margin: 0 auto;
}

.bg-grid,
.bg-noise {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.bg-grid {
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
  background-size: 50px 50px;
  mask-image: radial-gradient(circle at center, black 45%, transparent 100%);
  opacity: 0.65;
}

.bg-noise {
  background-image: radial-gradient(rgba(255, 255, 255, 0.08) 0.8px, transparent 0.8px);
  background-size: 14px 14px;
  opacity: 0.2;
}

.topbar {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 26px;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: 'Orbitron', sans-serif;
  font-size: 0.9rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--text);
}

.brand-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--cyan), var(--pink));
  box-shadow: 0 0 20px rgba(85, 227, 255, 0.9);
}

.nav {
  display: inline-flex;
  align-items: center;
  gap: 30px;
  padding: 12px 20px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgba(8, 12, 22, 0.4);
  backdrop-filter: blur(12px);
}

.nav a {
  color: var(--muted);
  text-decoration: none;
  text-transform: uppercase;
  font-size: 0.78rem;
  letter-spacing: 0.14em;
  transition: color 180ms ease;
}

.nav a:hover {
  color: var(--text);
}

.primary-btn,
.secondary-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 22px;
  border-radius: 999px;
  text-decoration: none;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  font-size: 0.76rem;
  font-weight: 700;
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.primary-btn {
  background: linear-gradient(135deg, #8d7bff 0%, #5ae1ff 100%);
  color: #030813;
  box-shadow: 0 14px 34px rgba(109, 121, 255, 0.48);
}

.secondary-btn {
  border: 1px solid rgba(162, 185, 255, 0.28);
  color: var(--text);
  background: rgba(16, 21, 34, 0.4);
}

.primary-btn:hover,
.secondary-btn:hover {
  transform: translateY(-1px);
}

.primary-btn.small {
  min-height: 40px;
  padding: 0 18px;
}

.hero {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 42px;
  padding-top: 86px;
  padding-bottom: 48px;
}

.eyebrow,
.section-label {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--cyan);
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-size: 0.72rem;
  font-weight: 700;
}

.eyebrow::before,
.section-label::before {
  content: '';
  width: 28px;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--cyan));
}

.hero-copy h1 {
  margin: 18px 0 18px;
  font-family: 'Orbitron', sans-serif;
  font-size: clamp(3rem, 6vw, 7rem);
  line-height: 0.96;
  letter-spacing: -0.06em;
  text-transform: uppercase;
}

.line {
  display: block;
  opacity: 0;
  transform: translateY(24px);
  animation: revealUp 900ms ease forwards;
}

.line:nth-child(2) {
  animation-delay: 120ms;
}

.line:nth-child(3) {
  animation-delay: 240ms;
}

.accent {
  color: transparent;
  background: linear-gradient(135deg, #d7ebff 0%, #6fe3ff 30%, #a9a7ff 70%, #ff7dd8 100%);
  -webkit-background-clip: text;
  background-clip: text;
  filter: drop-shadow(0 0 20px rgba(118, 153, 255, 0.6));
}

.lede {
  max-width: 640px;
  margin: 0;
  color: var(--muted);
  font-size: 1.06rem;
  line-height: 1.8;
}

.cta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 30px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(120px, 1fr));
  gap: 16px;
  margin-top: 36px;
  max-width: 500px;
}

.stat-box {
  padding: 18px 16px;
  border: 1px solid rgba(164, 178, 212, 0.14);
  background: rgba(15, 19, 30, 0.52);
  border-radius: 18px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
}

.stat-box strong {
  display: block;
  font-size: clamp(1.3rem, 2vw, 2rem);
  font-weight: 800;
  color: var(--text);
}

.stat-box span {
  display: block;
  margin-top: 6px;
  color: var(--muted);
  font-size: 0.72rem;
  line-height: 1.4;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.hero-visual {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 620px;
}

.orbit,
.orb {
  position: absolute;
  border-radius: 50%;
}

.orbit {
  border: 1px solid rgba(187, 209, 255, 0.2);
  animation: spin 18s linear infinite;
}

.orbit-one {
  width: 460px;
  height: 460px;
}

.orbit-two {
  width: 560px;
  height: 560px;
  animation-duration: 26s;
  animation-direction: reverse;
}

.orb-core {
  width: 280px;
  height: 280px;
  background: radial-gradient(circle at 30% 30%, rgba(129, 248, 255, 0.92), rgba(114, 94, 255, 0.5) 36%, rgba(10, 16, 26, 0.15) 72%);
  box-shadow: 0 0 60px rgba(97, 158, 255, 0.5);
  filter: blur(2px);
  animation: pulse 4s ease-in-out infinite alternate;
}

.glass-card {
  position: relative;
  z-index: 2;
  width: min(420px, 86%);
  padding: 26px 24px 20px;
  border: 1px solid rgba(194, 214, 255, 0.18);
  border-radius: 28px;
  background: linear-gradient(180deg, rgba(14, 20, 29, 0.78), rgba(12, 17, 27, 0.9));
  backdrop-filter: blur(20px);
  box-shadow: 0 30px 80px rgba(2, 5, 14, 0.72);
  animation: float 8s ease-in-out infinite;
}

.card-topline {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--muted);
  font-size: 0.68rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #84f0bb;
  box-shadow: 0 0 18px #84f0bb;
}

.feature-card h2 {
  margin: 18px 0 20px;
  font-size: clamp(1.8rem, 3vw, 2.6rem);
  letter-spacing: -0.06em;
}

.signal-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  margin-bottom: 20px;
}

.signal-bar span {
  display: block;
  height: 66px;
  border-radius: 12px;
  background: linear-gradient(180deg, rgba(75, 233, 255, 0.18), rgba(88, 122, 255, 0.9));
  box-shadow: inset 0 0 18px rgba(255, 255, 255, 0.12), 0 0 22px rgba(96, 202, 255, 0.22);
}

.signal-bar span:nth-child(2) {
  opacity: 0.8;
}

.signal-bar span:nth-child(3) {
  opacity: 0.9;
}

.signal-bar span:nth-child(4) {
  opacity: 0.75;
}

.mini-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.mini-grid div {
  padding-top: 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.09);
}

.mini-grid small {
  display: block;
  color: var(--soft);
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.mini-grid strong {
  display: block;
  margin-top: 6px;
  font-size: 0.96rem;
}

.floating-tag {
  position: absolute;
  z-index: 3;
  padding: 12px 18px;
  border-radius: 999px;
  border: 1px solid rgba(173, 196, 255, 0.18);
  background: rgba(13, 18, 29, 0.72);
  box-shadow: 0 20px 40px rgba(5, 9, 18, 0.42);
  color: var(--text);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: 0.68rem;
  backdrop-filter: blur(8px);
  animation: drift 9s ease-in-out infinite;
}

.tag-one {
  top: 18%;
  right: 8%;
}

.tag-two {
  bottom: 18%;
  left: 4%;
  animation-delay: 2s;
}

.services,
.showcase {
  position: relative;
  z-index: 2;
  padding-top: 32px;
  padding-bottom: 40px;
}

.section-head {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 18px;
  margin-top: 24px;
}

.section-head h3 {
  margin: 0;
  font-size: clamp(2rem, 4vw, 3.3rem);
  line-height: 1.1;
  letter-spacing: -0.06em;
}

.section-head p {
  max-width: 480px;
  margin: 0;
  color: var(--muted);
  line-height: 1.8;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  margin-top: 32px;
}

.feature-item {
  padding: 28px 24px;
  border: 1px solid rgba(171, 188, 255, 0.12);
  border-radius: 24px;
  background: linear-gradient(180deg, rgba(12, 16, 25, 0.82), rgba(14, 18, 27, 0.7));
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.feature-index {
  color: var(--cyan);
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-size: 0.7rem;
}

.feature-item h4 {
  margin: 20px 0 14px;
  font-size: 1.45rem;
  letter-spacing: -0.04em;
}

.feature-item p {
  margin: 0;
  color: var(--muted);
  line-height: 1.8;
}

.showcase-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  margin-top: 30px;
}

.project-card {
  position: relative;
  min-height: 260px;
  padding: 20px 20px 22px;
  border-radius: 24px;
  overflow: hidden;
  border: 1px solid rgba(170, 186, 255, 0.14);
  background: rgba(9, 14, 25, 0.7);
}

.project-glow {
  position: absolute;
  inset: -18% auto auto -10%;
  width: 220px;
  height: 220px;
  border-radius: 50%;
  filter: blur(18px);
  opacity: 0.9;
}

.project-card.violet .project-glow {
  background: radial-gradient(circle, rgba(159, 124, 255, 0.9), transparent 66%);
}

.project-card.cyan .project-glow {
  background: radial-gradient(circle, rgba(85, 227, 255, 0.9), transparent 66%);
}

.project-card.gold .project-glow {
  background: radial-gradient(circle, rgba(255, 208, 122, 0.9), transparent 66%);
}

.project-meta {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--muted);
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.project-card h4 {
  position: absolute;
  left: 20px;
  bottom: 22px;
  z-index: 1;
  margin: 0;
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  letter-spacing: -0.06em;
}

.arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

@keyframes revealUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-16px);
  }
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@keyframes pulse {
  0% {
    transform: scale(0.96);
    opacity: 0.76;
  }
  100% {
    transform: scale(1.08);
    opacity: 1;
  }
}

@keyframes drift {
  0%,
  100% {
    transform: translate3d(0, 0, 0);
  }
  50% {
    transform: translate3d(8px, -18px, 0);
  }
}

@media (max-width: 920px) {
  .topbar {
    flex-wrap: wrap;
    gap: 18px;
  }

  .nav {
    order: 3;
    width: 100%;
    justify-content: center;
  }

  .hero {
    grid-template-columns: 1fr;
    padding-top: 52px;
  }

  .hero-visual {
    min-height: 500px;
  }

  .section-head {
    display: block;
  }

  .section-head p {
    margin-top: 14px;
  }

  .feature-grid,
  .showcase-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .wrap {
    width: min(100% - 20px, 1200px);
  }

  .topbar {
    padding-top: 18px;
  }

  .nav {
    gap: 14px;
    justify-content: space-between;
    padding: 10px 12px;
    overflow-x: auto;
  }

  .nav a {
    font-size: 0.66rem;
    letter-spacing: 0.12em;
  }

  .stats {
    grid-template-columns: 1fr;
  }

  .orb-core {
    width: 220px;
    height: 220px;
  }

  .feature-card {
    width: min(360px, 88%);
  }
}
